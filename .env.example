# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/business.db

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Vector Store
VECTOR_STORE=faiss
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG
RAG_TOP_K=5

# Memory
MEMORY_ENABLED=true
MEMORY_MAX_RESULTS=5

# Query Safety
MAX_QUERY_ROWS=1000
SQL_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
